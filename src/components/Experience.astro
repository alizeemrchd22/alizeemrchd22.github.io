---
import Arrow from "./Arrow.astro";
import { site } from "../data/content";

// href = ancre correspondante sur /about (page "Professional Experience"),
// où chaque mission est détaillée. IJC n'y a pas encore de section dédiée,
// donc son lien renvoie sur la page générale en attendant.
const rows = [
  { key: "saphes", logo: "exp-saphes.webp", company: "Saphes", role: "Project Management & UI/UX Designer", year: "2025-2026",
    description: "Driving product and design work end-to-end: from user research and wireframes to shipped interfaces and project coordination.",
    tags: ["Project Management", "UI/UX", "Figma"], href: "/about#saphes-2025" },
  { key: "peftrust", logo: "exp-peftrust.webp", company: "PEFtrust", role: "ISO 27001 Project Manager", year: "2025-2026",
    description: "Leading ISO 27001 certification programme, translating security standards into practical processes, and helping teams make security part of their everyday work.",
    tags: ["Cybersecurity", "PM", "Security Policies", "Operational Procedures", "Security KPIs & Alerting"], href: "/about#peftrust-iso" },
  { key: "maersk", logo: "exp-maersk.webp", company: "Maersk", role: "Process", year: "2025-2026",
    description: "Mapping and improving operational processes to make day-to-day logistics workflows clearer and more efficient.",
    tags: ["Process", "Operations"], href: "/about#maersk" },
  { key: "ijc", logo: "exp-ijc.webp", company: "IJC", role: "Mobile App Development", year: "2025-2026",
    description: "Contributing to the design and build of a mobile application, from concept through to functional features.",
    tags: ["Mobile", "Development"], href: "/about" },
];
---

<section class="exp" id="experience">
  <div class="container">
    <header class="exp__head">
      <h2 class="section-title" data-i18n="experience.title">So, what I’ve been up to ?</h2>
      <p class="exp__intro" data-i18n="experience.intro">A mix of projects, challenges and roles that took me across industries. I’ve explored different worlds, picked up new skills, and learned how to connect the dots between business, tech and design.</p>
      <div class="exp__cta">
        <a href={`mailto:${site.email}`} class="btn btn--primary"><span data-i18n="common.letsGetInTouch">Let’s get in Touch!</span> <Arrow /></a>
        <a href="/about" class="btn btn--outline"><span data-i18n="experience.ctaSeeFull">See full experience</span> <Arrow /></a>
      </div>
    </header>

    <ul class="exp__list">
      {rows.map((r) => (
        <li class="exp-row" tabindex="0">
          <div class="exp-row__header">
            <div class="exp-row__left">
              <img class="exp-row__logo" src={`/assets/${r.logo}`} alt={`${r.company} logo`} width="48" height="48" />
              <span class="exp-row__company">{r.company}</span>
              <span class="exp-row__role">{r.role}</span>
            </div>
            <span class="exp-row__year">{r.year}</span>
          </div>

          <div class="exp-row__collapse">
            <div class="exp-row__detail">
              <p class="exp-row__desc" data-i18n={`experience.${r.key}.desc`}>{r.description}</p>
              <ul class="exp-row__tags">
                {r.tags.map((t) => <li class="chip chip--dark">{t}</li>)}
              </ul>
              <a href={r.href} class="btn btn--outline exp-row__link"><span data-i18n="common.readMissions">Read the missions</span> <Arrow /></a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .exp { background: var(--bg); padding-block: clamp(3.5rem, 7vw, 6rem); }
  .exp__head { text-align: center; max-width: 790px; margin: 0 auto clamp(2.5rem, 5vw, 4rem); }
  .exp__intro { margin-top: 24px; color: rgba(255,255,255,.8); font-size: 18px; line-height: 1.5; }
  .exp__cta { display: inline-flex; flex-wrap: wrap; gap: 24px; justify-content: center; margin-top: 32px; }

  .exp__list { display: flex; flex-direction: column; }
  .exp-row {
    border-top: 1px solid rgba(255,255,255,.1);
    border-radius: 20px;
    transition: background .35s ease;
    outline: none;
  }
  .exp__list .exp-row:last-child { border-bottom: 1px solid rgba(255,255,255,.1); }
  .exp-row:hover, .exp-row:focus-visible { background: #1e1e1e; }
  .exp-row:focus-visible { box-shadow: inset 0 0 0 2px rgba(252,255,64,.4); }

  .exp-row__header {
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; padding: 24px; min-height: 96px; cursor: pointer;
  }
  .exp-row__left { display: flex; align-items: center; gap: 56px; }
  .exp-row__logo { width: 48px; height: 48px; border-radius: 14px; flex: none; }
  .exp-row__company { font-family: var(--font); font-weight: 300; font-size: 24px; line-height: 1.35; color: #fff; width: 148px; }
  .exp-row__role { font-family: var(--font); font-weight: 300; font-size: 24px; line-height: 1.35; color: #fff; }
  .exp-row__year { font-size: 18px; color: #7a7571; white-space: nowrap; }

  /* Accordéon : fermé par défaut, ouverture douce pilotée en JS (hauteur exacte) */
  .exp-row__collapse {
    overflow: hidden;
    max-height: 0;
    transition: max-height .7s cubic-bezier(.33, 1, .3, 1);
  }
  .exp-row__detail {
    display: flex; flex-direction: column; gap: 40px;
    padding: 8px 40px 40px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity .55s ease .08s, transform .6s cubic-bezier(.22,1,.36,1) .05s;
  }
  .exp-row.is-open .exp-row__detail { opacity: 1; transform: translateY(0); }
  .exp-row__desc { font-family: "Manrope", var(--font); font-size: 18px; line-height: 28px; letter-spacing: 0.36px; color: #9c9c9c; max-width: 736px; }
  .exp-row__tags { display: flex; flex-wrap: wrap; gap: 24px; }
  .exp-row__link { align-self: flex-start; }

  @media (max-width: 820px) {
    .exp-row__left { gap: 16px; flex-wrap: wrap; }
    .exp-row__company { width: auto; }
    .exp-row__header { flex-wrap: wrap; }
    .exp-row.is-open .exp-row__detail { padding: 8px 20px 28px; }
    .exp-row__tags { gap: 12px; }
  }
</style>

<script>
  // Ouverture/fermeture douce : hauteur exacte mesurée → pas de temps mort ni de claquement
  document.querySelectorAll(".exp-row").forEach((row) => {
    const collapse = row.querySelector(".exp-row__collapse");
    const detail = row.querySelector(".exp-row__detail");
    if (!collapse || !detail) return;

    const open = () => {
      row.classList.add("is-open");
      collapse.style.maxHeight = collapse.scrollHeight + "px";
      detail.style.opacity = "1";
      detail.style.transform = "translateY(0)";
    };
    const close = () => {
      row.classList.remove("is-open");
      collapse.style.maxHeight = "0px";
      detail.style.opacity = "0";
      detail.style.transform = "translateY(10px)";
    };

    row.addEventListener("mouseenter", open);
    row.addEventListener("mouseleave", close);
    row.addEventListener("focusin", open);
    row.addEventListener("focusout", (e) => {
      if (!row.contains(e.relatedTarget)) close();
    });
  });
</script>
