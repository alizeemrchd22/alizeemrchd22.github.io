---
import Arrow from "./Arrow.astro";
import { site } from "../data/content";

// Icônes pleines, dans l'esprit des icônes Values (soleil / yeux / montagne)
const icons = {
  // Diamant taillé : une valeur qui ne se négocie pas, et qu'on voit à travers
  integrity: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.4 3.8h9.2l3.9 5.6-8.5 10.8L3.5 9.4z"/><path d="M3.5 9.4h17"/><path d="M9.2 3.9 7.6 9.4 12 20.2l4.4-10.8-1.6-5.5"/></svg>`,
  collaboration: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="8.2" cy="7.2" r="3.4"/><path d="M1.8 19.6c0-3.5 2.9-6.4 6.4-6.4s6.4 2.9 6.4 6.4v.4H1.8v-.4z"/><circle cx="17.3" cy="8.6" r="2.7"/><path d="M14.6 19.9c.2-2.5 1.4-4.6 3.2-5.6.5-.2 1-.3 1.5-.3 2.4 0 4.4 2.3 4.6 5.4l0 .6h-9.3v-.1z"/></svg>`,
  // Jeune pousse : ça grandit à chaque projet (et ça reste vivant)
  continuous: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><g transform="translate(-1.3 0)"><path d="M12.6 21.4c-.4-4.4.1-7.7 1.6-10" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M14.2 11.4c-.8-2.7.1-5.1 2.6-7 1.5-1.1 3.2-1.5 3.7-1 .5.5.2 2.2-.7 3.9-1.4 2.6-3.3 4-5.6 4.1z" fill="currentColor"/><path d="M12.7 13.8c-2.1.4-4-.3-5.6-2-1.2-1.3-1.8-2.9-1.3-3.4.5-.5 2.2-.1 3.8.9 2.2 1.3 3.4 2.9 3.6 4.5z" fill="currentColor"/></g></svg>`,
  quality: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21S3 15.5 3 9.5C3 6.4 5.4 4 8.4 4c1.5 0 2.8.7 3.6 1.7C12.8 4.7 14.1 4 15.6 4 18.6 4 21 6.4 21 9.5c0 6-9 11.5-9 11.5z"/></svg>`,
};

const cards = [
  { pos: "integrity", key: "integrity", title: "Integrity", icon: icons.integrity,
    text: "I value honesty, transparency and respect in every collaboration. Great work starts with trust." },
  { pos: "collaboration", key: "collaboration", title: "Collaboration", icon: icons.collaboration,
    text: "The strongest solutions emerge when different perspectives meet. I believe in listening, constructive debate and shared ownership." },
  { pos: "continuous", key: "continuous", title: "Continuous Improvement", icon: icons.continuous,
    text: "Every project is an opportunity to improve a product, refine a process and work more effectively together." },
  { pos: "quality", key: "quality", title: "Quality", icon: icons.quality,
    text: "If something is worth doing, it’s worth doing well. I strive to create work that is thoughtful, useful and built to last." },
];
---

<section class="ethic" id="work-ethic">
  <div class="ethic__inner">
    <header class="ethic__head">
      <h2 class="section-title ethic__title" data-i18n="workethic.title">My work Ethic</h2>
      <p class="ethic__subtitle" data-i18n="workethic.subtitle">I believe the best work is built on trust, curiosity and shared purpose.</p>
      <div class="ethic__cta">
        <a href={site.phoneHref} class="btn btn--primary"><span data-i18n="common.letsCall">Let’s call</span> <Arrow /></a>
        <a href="/about" class="btn btn--outline-dark"><span data-i18n="common.professionalExperience">Professional Experience</span> <Arrow /></a>
      </div>
    </header>

    <div class="ethic__paras">
      <p data-i18n="workethic.para1">I enjoy building environments where ideas can be questioned, improved and transformed into meaningful and efficient solutions.</p>
      <p data-i18n="workethic.para2">Every conversation, every challenge and every project is an opportunity to learn.</p>
    </div>

    <!-- Rectangle : [photo] [Integrity] [Collaboration] / [Continuous Improvement] [Quality]
         La photo sort de la carte Continuous Improvement pour combler la case vide. -->
    <div class="ethic__grid">
      <div class="ethic__photo-cell" aria-hidden="false">
        <img class="ethic__photo" src="/assets/workethic-cutout.png" alt="Portrait d’Alizée Marchand" width="1000" height="1369" loading="lazy" />
      </div>
      {cards.map((c) => (
        <article class:list={["ecard", `ecard--${c.pos}`]}>
          <div class="ecard__text">
            <h3 class="ecard__title" data-i18n={`workethic.${c.key}.title`}>{c.title}</h3>
            <p class="ecard__desc" data-i18n={`workethic.${c.key}.desc`}>{c.text}</p>
          </div>
          <span class="ecard__icon" set:html={c.icon}></span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ethic {
    position: relative;
    z-index: 2; /* au-dessus de la photo prolongée de la section Languages */
    background: var(--cream);
    color: var(--ink);
    border-top-left-radius: var(--section-radius);
    border-bottom-right-radius: var(--section-radius);
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    overflow: hidden;
  }
  .ethic__inner { position: relative; width: 100%; max-width: 1236px; margin-inline: auto; padding-inline: 24px; }
  .ethic__head { text-align: center; max-width: 782px; margin: 0 auto; }
  .ethic__title { color: var(--ink); }
  .ethic__subtitle { margin-top: 16px; color: var(--ink); font-size: 18px; line-height: 1.5; }
  .ethic__cta { display: inline-flex; flex-wrap: wrap; gap: 24px; justify-content: center; margin-top: 32px; }
  .ethic__paras {
    max-width: 850px; margin: clamp(2.5rem, 5vw, 4rem) 0 clamp(2rem, 4vw, 3rem);
    padding-left: clamp(0px, 15vw, 200px);
    display: flex; flex-direction: column; gap: 24px;
    color: #8a8986; font-size: 18px; line-height: 1.5;
  }

  /* --- Le rectangle : 12 colonnes, 2 rangées --- */
  .ethic__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
  }

  /* Case photo (en haut à gauche) : la photo est ancrée en bas et déborde
     sur la carte Continuous Improvement en dessous → effet "elle en sort" */
  .ethic__photo-cell {
    grid-column: 1 / 4; grid-row: 1;
    position: relative;
    z-index: 0; /* la photo passe SOUS les cartes → effet "elle en sort" */
  }
  .ethic__photo {
    position: absolute;
    bottom: -60px;              /* plonge dans la carte du dessous (gap 24 + 36) */
    left: 0;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  .ecard {
    position: relative;
    z-index: 1; /* au-dessus de la photo */
    background: #fff;
    border-radius: 40px;
    padding: 40px;
    min-height: 300px;
    overflow: hidden;
    display: flex; flex-direction: column;
    transition: background .35s ease, transform .35s cubic-bezier(.22,1,.36,1);
  }
  .ecard--integrity     { grid-column: 4 / 7;  grid-row: 1; }
  .ecard--collaboration { grid-column: 7 / 13; grid-row: 1; }
  .ecard--continuous    { grid-column: 1 / 9;  grid-row: 2; }
  .ecard--quality       { grid-column: 9 / 13; grid-row: 2; }

  /* Continuous Improvement : texte aligné à gauche comme les autres cartes */
  .ecard--continuous .ecard__text { max-width: 72%; }

  .ecard__text { display: flex; flex-direction: column; gap: 8px; max-width: 90%; }
  .ecard__title { font-family: var(--font); font-weight: 600; font-size: 18px; line-height: 1.5; color: #191919; transition: color .35s ease; }
  .ecard__desc { font-size: 18px; line-height: 1.5; color: #adadad; transition: color .35s ease; }
  .ecard__icon {
    position: absolute; right: 28px; bottom: 28px;
    width: 52px; height: 52px; color: var(--primary);
    transition: color .35s ease, transform .35s cubic-bezier(.22,1,.36,1);
  }
  .ecard__icon :global(svg) { width: 100%; height: 100%; display: block; }

  /* Hover : jaune + noir (langage du site) */
  .ecard:hover { background: var(--primary); transform: translateY(-4px); }
  .ecard:hover .ecard__title,
  .ecard:hover .ecard__desc { color: #191919; }
  .ecard:hover .ecard__icon { color: #191919; transform: scale(1.1) rotate(-4deg); }

  @media (max-width: 1024px) {
    .ethic { border-top-left-radius: clamp(60px,12vw,90px); border-bottom-right-radius: clamp(60px,12vw,90px); }
    .ethic__paras { padding-left: 0; }
    .ethic__grid { grid-template-columns: repeat(2, 1fr); }
    .ethic__photo-cell { grid-column: 1 / -1; grid-row: auto; }
    .ethic__photo { position: static; width: min(320px, 70%); margin-inline: auto; display: block; }
    .ecard { grid-column: auto !important; grid-row: auto !important; min-height: 260px; }
    .ecard--continuous .ecard__text { max-width: 90%; }
  }
  @media (max-width: 640px) {
    .ethic__grid { grid-template-columns: 1fr; }
  }
</style>
