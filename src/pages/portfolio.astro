---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import PageHero from "../components/PageHero.astro";
import DigCta from "../components/DigCta.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/content";
import { dsProjects, toolbox } from "../data/dsProjects";

const mlCount = dsProjects.filter((p) => p.category === "ml").length;
const engCount = dsProjects.filter((p) => p.category === "engineering").length;
---

<Layout
  title={`My Portfolio · ${site.name}`}
  description="Data Science projects by Alizée Marchand: models, stacks, code and reports."
>
  <main id="main">
    <PageHero
      eyebrow="Data Science Portfolio"
      title="Turning raw data into decisions you can act on."
      sub="Machine learning and data engineering projects, from cybersecurity to cloud pipelines. For each one: the problem, my approach, the code and the full report."
      ctas={[
        { label: "Let’s talk data", href: `mailto:${site.email}` },
        { label: "My competencies", href: "/competencies" },
      ]}
    >
      <ul class="dhero__stats">
        <li><span>{dsProjects.length}</span> projects</li>
        <li><span>{dsProjects.reduce((n, p) => n + (p.models?.length ?? 0), 0)}</span> models trained</li>
        <li><span>Python</span> first</li>
      </ul>
    </PageHero>

    <!-- ============ PROJET FAVORI (emplacement réservé) ============ -->
    <!-- Section à designer plus tard, quand Alizée aura choisi le projet. -->
    <section class="pfav" id="favorite">
      <div class="container">
        <h2 class="section-title pfav__title">My Favorite Project</h2>
        <p class="pfav__soon">Coming soon.</p>
      </div>
    </section>

    <!-- ============ LISTING DES PROJETS (section claire) ============ -->
    <!-- Trois colonnes décalées : la répartition initiale est faite au build,
         le JS rééquilibre vers la colonne la plus courte. -->
    <section class="plist" id="projects">
      <div class="container">
        <header class="plist__head">
          <h2 class="section-title">Selected projects</h2>
          <p class="plist__sub">Machine learning and data engineering, from raw files to answers a team can act on.</p>
          <div class="plist__filters" role="group" aria-label="Filter projects by field">
            {[
              { id: "all", label: "All", n: dsProjects.length },
              { id: "ml", label: "Machine Learning", n: mlCount },
              { id: "engineering", label: "Data Engineering", n: engCount },
            ].map((f) => (
              <button type="button" class:list={["pfilter", { "is-active": f.id === "all" }]} data-filter={f.id} aria-pressed={f.id === "all" ? "true" : "false"}>
                {f.label} <span class="pfilter__n">{f.n}</span>
              </button>
            ))}
          </div>
        </header>

        <div class="plist__grid" id="plist-grid">
          {[0, 1, 2].map((c) => (
            <div class="plist__col" data-col={c}>
              {dsProjects.filter((_, i) => i % 3 === c).map((p) => (
                <article class="ptile" data-category={p.category}>
                  <div class="ptile__body">
                    <span class:list={["ptile__tag", p.category === "ml" ? "ptile__tag--ml" : "ptile__tag--eng"]}>
                      {p.category === "ml" ? "Machine Learning" : "Data Engineering"}
                    </span>
                    <h3 class="ptile__title">{p.title}</h3>
                    <p class="ptile__pitch">{p.pitch}</p>
                  </div>

                  <img class="ptile__art" src={`/assets/projects/art-${p.id}.webp`} alt="" aria-hidden="true" loading="lazy" width="760" height="560" />

                  <span class="ptile__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H8M17 7v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>

                  {p.detailUrl ? (
                    <a class="ptile__cta" href={p.detailUrl} aria-label={`Read the case study: ${p.title}`}></a>
                  ) : (
                    <button type="button" class="ptile__cta" data-open={p.id} aria-haspopup="dialog" aria-label={`See the details: ${p.title}`}></button>
                  )}
                </article>
              ))}
            </div>
          ))}
        </div>

        <p class="plist__empty" id="plist-empty" hidden>No project in this category yet.</p>
      </div>

    </section>

    <!-- Pop-ups : un <dialog> natif par projet (Échap et clic extérieur ferment) -->
    {dsProjects.filter((p) => !p.detailUrl).map((p) => (
      <dialog class="pmodal" id={`modal-${p.id}`} aria-label={p.title}>
        <button type="button" class="pmodal__close" data-close aria-label="Close">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
        <div class="pmodal__inner">
          <div class="dcard__meta">
            <span class="dchip dchip--yellow">{p.type}</span>
            <span class="dcard__period">{p.period}</span>
          </div>
          <h2 class="pmodal__title">{p.title}</h2>
          <p class="dcard__pitch">{p.pitch}</p>

          <div class="pmodal__body">
            <div class="pmodal__text">
              <div class="dblock"><h3 class="dblock__label">The problem</h3><p>{p.context}</p></div>
              <div class="dblock"><h3 class="dblock__label">My approach</h3><p>{p.approach}</p></div>
              <div class="dblock"><h3 class="dblock__label">The outcome</h3><p>{p.impact}</p></div>
            </div>

            <aside class="dspec">
              <div class="dspec__group">
                <h3 class="dspec__label">Stack</h3>
                <ul class="dspec__chips">{p.stack.map((s) => <li class="dchip">{s}</li>)}</ul>
              </div>

              {p.models && p.models.length > 0 && (
                <div class="dspec__group">
                  <h3 class="dspec__label">Models trained</h3>
                  <ul class="dmodels">
                    {p.models.map((m) => (
                      <li class="dmodel">
                        <span class="dmodel__name">{m.name}</span>
                        <span class="dmodel__metric">{m.metric}</span>
                        <span class="dmodel__value">{m.value}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="dspec__group">
                <h3 class="dspec__label">Keywords</h3>
                <ul class="dspec__chips">{p.keywords.map((k) => <li class="dchip dchip--soft">{k}</li>)}</ul>
              </div>
            </aside>
          </div>

          <footer class="pmodal__foot">
            <a href={p.codeUrl} class="btn btn--primary" target="_blank" rel="noopener noreferrer">View the code <Arrow /></a>
            {p.pdfUrl && <a href={p.pdfUrl} class="btn btn--outline" download>Download the report <Arrow /></a>}
          </footer>
        </div>
      </dialog>
    ))}

    <DigCta />

    <!-- ============ TOOLBOX (section claire) ============ -->
    <section class="dtools">
      <div class="container">
        <header class="dtools__head">
          <h2 class="section-title dtools__title">The toolbox behind it</h2>
          <p class="dtools__sub">Everything I reach for, from first exploration to a shareable app.</p>
        </header>
        <div class="dtools__grid">
          {toolbox.map((g) => (
            <div class="dtools__group">
              <h3 class="dtools__label">{g.label}</h3>
              <ul class="dtools__chips">
                {g.items.map((i) => <li class="dchip dchip--light">{i}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* ---------------- HERO (photo + voile dégradé, cohérent avec le reste du site) ---------------- */
  /* Stats passées en slot dans le PageHero commun */
  .dhero__stats {
    display: flex; flex-wrap: wrap; gap: clamp(24px, 4vw, 56px);
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-top: clamp(1.25rem, 2.5vw, 1.75rem);
    border-top: 1px solid rgba(255,255,255,.12);
  }
  .dhero__stats li { color: rgba(255,255,255,.45); font-size: 15px; }
  .dhero__stats span { display: block; color: var(--white); font-size: 26px; font-weight: 300; letter-spacing: -.01em; }

  /* ---------------- PROJETS ---------------- */
  .dprojects { background: var(--bg); padding-block: clamp(3.5rem, 7vw, 6rem); }
  .dprojects .container { display: flex; flex-direction: column; gap: clamp(2rem, 4vw, 3rem); }

  /* ---- EMPILEMENT AU SCROLL ----
     Chaque carte est `sticky`, mais son offset `top` est calculé en JS pour
     qu'elle ne se fige QU'APRÈS avoir été vue en entier (top = viewport −
     hauteur de la carte, donc souvent négatif ici). La suivante remonte alors
     par-dessus. Les offsets décalés laissent dépasser un liseré de chaque
     carte déjà lue → on voit vraiment une pile. */
  .dcard {
    position: sticky;
    top: var(--stack-top, 0px);
    overflow: hidden;
    /* fond opaque obligatoire : les cartes se superposent */
    background: #1e1e1e;
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 40px;
    padding: clamp(2rem, 4vw, 3.25rem);
    box-shadow: 0 -26px 60px -26px rgba(0,0,0,.65);
    transform-origin: 50% 100%;
    will-change: transform, opacity;
    transition: border-color .4s ease, background .4s ease;
  }
  .dcard:hover { border-color: rgba(252,255,64,.22); background: #212121; }

  /* Pas d'empilement si l'utilisateur refuse les animations */
  @media (prefers-reduced-motion: reduce) {
    .dcard { position: relative; top: auto; box-shadow: none; }
  }
  /* Halo parfaitement circulaire (width = height en px) → plus de forme "patate" */
  .dcard__glow {
    position: absolute; top: -190px; right: -130px;
    width: 520px; height: 520px;
    border-radius: 50%;
    background: radial-gradient(circle at center,
      rgba(252,255,64,.20) 0%,
      rgba(252,255,64,.11) 32%,
      rgba(252,255,64,.045) 56%,
      rgba(252,255,64,0) 74%);
    filter: blur(34px);
    opacity: .9;
    transition: opacity .5s ease, transform .7s cubic-bezier(.22,1,.36,1);
    pointer-events: none;
  }
  .dcard:hover .dcard__glow { opacity: 1; transform: translate(-16px, 18px) scale(1.08); }
  .dcard__index {
    position: absolute; top: clamp(1rem, 2vw, 1.75rem); right: clamp(1.5rem, 3vw, 2.75rem);
    font-weight: 300; font-size: clamp(3.5rem, 7vw, 6rem); line-height: 1;
    letter-spacing: -.04em; color: rgba(250,250,250,.07);
    pointer-events: none;
  }

  .dcard__head { position: relative; max-width: 62ch; }
  .dcard__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .dcard__period { color: rgba(255,255,255,.4); font-size: 15px; }
  .dcard__title {
    margin-top: 18px; font-family: var(--font); font-weight: 300;
    font-size: clamp(1.9rem, 3.4vw, 2.75rem); line-height: 1.08; letter-spacing: -.02em;
    color: var(--white);
  }
  .dcard__pitch { margin-top: 14px; color: rgba(255,255,255,.72); font-size: 18px; line-height: 1.55; }

  .dcard__body {
    position: relative;
    display: grid; grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: clamp(2rem, 3.5vw, 2.75rem);
    padding-top: clamp(1.75rem, 3vw, 2.25rem);
    border-top: 1px solid rgba(255,255,255,.07);
  }
  .dcard__story { display: flex; flex-direction: column; gap: 26px; }
  .dblock__label {
    font-family: var(--font); font-size: 13px; font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase; color: var(--primary);
  }
  .dblock p { margin-top: 10px; color: rgba(250,250,250,.6); font-size: 16.5px; line-height: 1.65; }

  /* Fiche technique */
  .dspec {
    display: flex; flex-direction: column; gap: 28px;
    background: rgba(0,0,0,.22);
    border: 1px solid rgba(255,255,255,.05);
    border-radius: 28px;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    align-self: start;
  }
  .dspec__label {
    font-family: var(--font); font-size: 13px; font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.45);
    margin-bottom: 14px;
  }
  .dspec__chips { display: flex; flex-wrap: wrap; gap: 8px; }

  .dchip {
    display: inline-flex; align-items: center;
    padding: 7px 14px; border-radius: 999px;
    background: rgba(240,239,233,.05);
    border: 1px solid rgba(240,239,233,.10);
    color: rgba(240,239,233,.8);
    font-size: 14px; line-height: 1.4; white-space: nowrap;
  }
  .dchip--yellow {
    background: rgba(252,255,64,.06);
    border-color: rgba(252,255,64,.24);
    color: var(--primary);
    font-weight: 600; font-size: 13px; letter-spacing: .04em;
  }
  .dchip--soft { background: transparent; border-color: rgba(240,239,233,.12); color: rgba(240,239,233,.6); }
  .dchip--light {
    background: rgba(25,25,25,.05);
    border-color: rgba(25,25,25,.12);
    color: #4f4b47;
  }

  /* Modèles entraînés */
  .dmodels { display: flex; flex-direction: column; }
  .dmodel {
    display: grid; grid-template-columns: 1fr auto auto;
    align-items: baseline; gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255,255,255,.06);
  }
  .dmodel:last-child { border-bottom: none; padding-bottom: 0; }
  .dmodel:first-child { padding-top: 0; }
  .dmodel__name { color: rgba(250,250,250,.88); font-size: 15.5px; line-height: 1.4; }
  .dmodel__metric { color: rgba(255,255,255,.38); font-size: 13px; letter-spacing: .04em; text-transform: uppercase; }
  .dmodel__value {
    font-family: "Red Hat Mono", monospace;
    color: var(--primary); font-size: 15px; font-weight: 500;
    min-width: 4ch; text-align: right;
  }

  .dcard__foot {
    position: relative;
    display: flex; flex-wrap: wrap; gap: 18px;
    margin-top: clamp(2rem, 3.5vw, 2.75rem);
  }
  .dcard__foot .btn { padding: 22px 26px; }
  .dcard__foot svg { flex: none; }

  /* ---------------- TOOLBOX (clair) ---------------- */
  .dtools {
    background: var(--cream); color: var(--ink);
    border-top-left-radius: var(--section-radius);
    border-bottom-right-radius: var(--section-radius);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }
  .dtools__head { text-align: center; max-width: 640px; margin: 0 auto clamp(2.5rem, 5vw, 3.5rem); }
  .dtools__title { color: var(--ink); }
  .dtools__sub { margin-top: 18px; color: #6f6b67; font-size: 18px; }
  .dtools__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.75rem, 3vw, 2.75rem) clamp(1.5rem, 3vw, 2.5rem); }
  .dtools__label {
    font-family: var(--font); font-size: 13px; font-weight: 600;
    letter-spacing: .12em; text-transform: uppercase; color: #191919;
    padding-bottom: 14px; margin-bottom: 16px;
    border-bottom: 1px solid rgba(25,25,25,.12);
  }
  .dtools__chips { display: flex; flex-wrap: wrap; gap: 8px; }

  /* ---------------- RESPONSIVE ---------------- */
  @media (max-width: 1024px) {
    .dtools__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .dtools { border-top-left-radius: clamp(60px,12vw,90px); border-bottom-right-radius: clamp(60px,12vw,90px); }
    /* écrans courts : la pile gênerait la lecture, on repasse en liste */
    .dcard { position: relative; top: auto; box-shadow: none; }
    .dcard__body { grid-template-columns: 1fr; }
    .dcard__index { font-size: 3.5rem; }
  }
  @media (max-width: 600px) {
    .dtools__grid { grid-template-columns: 1fr; }
    .dcard__foot .btn { width: 100%; justify-content: center; }
  }

  /* ---------- PROJET FAVORI (emplacement réservé) ---------- */
  .pfav { background: var(--bg); padding-block: clamp(3rem, 6vw, 5rem); }
  .pfav__title { text-align: center; }
  .pfav__soon {
    margin-top: 18px; text-align: center;
    color: rgba(255,255,255,.35); font-size: 15px; letter-spacing: .04em;
  }

  /* ---------- LISTING (section claire, même courbe que la Toolbox) ---------- */
  .plist {
    position: relative;
    background: var(--cream); color: var(--ink);
    border-top-left-radius: var(--section-radius);
    border-bottom-right-radius: var(--section-radius);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }
  .plist__head { max-width: 720px; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .plist .section-title { color: var(--ink); }
  .plist__sub { margin-top: 18px; color: rgba(25,25,25,.6); font-size: 18px; line-height: 1.55; }

  .plist__filters { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .pfilter {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 11px 20px; border-radius: 999px; cursor: pointer;
    background: transparent; border: 1px solid rgba(25,25,25,.18);
    color: rgba(25,25,25,.7); font: inherit; font-size: 15px;
    transition: background .25s, border-color .25s, color .25s;
  }
  .pfilter:hover { border-color: rgba(25,25,25,.45); color: var(--ink); }
  .pfilter__n { font-size: 12px; opacity: .5; }
  .pfilter.is-active { background: #191919; border-color: #191919; color: var(--white); }
  .pfilter.is-active .pfilter__n { opacity: .6; }

  /* Vraies colonnes flex : en colonnes CSS, la marge en haut d'une colonne
     est tronquée par la spec, impossible d'y décaler les colonnes. */
  .plist__grid { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
  .plist__col { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  /* `display: flex` l'emporte sur le display:none par défaut de [hidden] */
  .ptile[hidden], .plist__col[hidden] { display: none !important; }
  .plist__col[data-col="1"] { margin-top: 96px; }
  .plist__col[data-col="2"] { margin-top: 44px; }

  .ptile {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column;
    min-height: 430px;
    background: #1a1a1a;
    border-radius: 30px;
    transition: transform .55s cubic-bezier(.22,1,.36,1), box-shadow .45s ease;
  }
  .ptile:hover { transform: translateY(-10px); box-shadow: 0 26px 58px rgba(25,25,25,.22); }

  .ptile__body { position: relative; z-index: 2; padding: clamp(26px, 2.5vw, 34px); }

  .ptile__tag {
    display: inline-block; margin-bottom: 20px;
    font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
    padding: 7px 14px; border-radius: 999px;
  }
  .ptile__tag--ml  { color: #FCFF40; background: rgba(252,255,64,.10); border: 1px solid rgba(252,255,64,.30); }
  .ptile__tag--eng { color: #5FD9FF; background: rgba(95,217,255,.10); border: 1px solid rgba(95,217,255,.30); }

  .ptile__title {
    font-family: var(--font); font-weight: 400; letter-spacing: -.02em;
    font-size: clamp(1.35rem, 2.1vw, 1.75rem); line-height: 1.18; color: var(--white);
  }
  .ptile__pitch { margin-top: 14px; color: rgba(250,250,250,.58); font-size: 15.5px; line-height: 1.6; }

  /* Artwork : ancré en bas, il déborde légèrement et réagit au survol */
  .ptile__art {
    position: absolute; left: 50%; bottom: -8%;
    width: 128%; height: auto; z-index: 1;
    transform: translateX(-50%);
    transition: transform .75s cubic-bezier(.22,1,.36,1), opacity .45s ease;
    opacity: .92; pointer-events: none;
  }
  .ptile:hover .ptile__art { transform: translateX(-50%) translateY(-10px) scale(1.09); opacity: 1; }

  /* Flèche : apparaît au survol, remplace l'ancien curseur custom */
  .ptile__arrow {
    position: absolute; top: 24px; right: 24px; z-index: 3;
    display: flex; align-items: center; justify-content: center;
    width: 46px; height: 46px; border-radius: 50%;
    background: var(--primary); color: #191919;
    opacity: 0; transform: scale(.4) rotate(-35deg);
    transition: opacity .4s ease, transform .5s cubic-bezier(.22,1,.36,1);
  }
  .ptile__arrow svg { width: 21px; height: 21px; }
  .ptile:hover .ptile__arrow,
  .ptile:focus-within .ptile__arrow { opacity: 1; transform: scale(1) rotate(0); }

  .ptile__cta { position: absolute; inset: 0; z-index: 4; cursor: pointer; background: none; border: none; }
  .ptile__cta:focus-visible { outline: 2px solid #191919; outline-offset: 4px; border-radius: 30px; }

  .plist__empty { margin-top: 24px; color: rgba(25,25,25,.5); }

  @media (prefers-reduced-motion: reduce) { .ptile, .ptile__art, .ptile__arrow { transition: none; } }

  @media (max-width: 1024px) {
    .plist__col[data-col="1"] { margin-top: 70px; }
    .plist__col[data-col="2"] { margin-top: 0; }
  }
  @media (max-width: 680px) {
    .plist__col[data-col="1"], .plist__col[data-col="2"] { margin-top: 0; }
  }

  /* ---------- POP-UP PROJET ---------- */
  .pmodal {
    width: min(1040px, calc(100vw - 32px));
    max-height: min(86vh, 900px);
    padding: 0; border: 1px solid rgba(255,255,255,.1); border-radius: 32px;
    background: #1c1c1c; color: var(--white);
    overflow: hidden;
  }
  .pmodal::backdrop { background: rgba(10,10,10,.72); backdrop-filter: blur(6px); }
  .pmodal__inner { overflow-y: auto; max-height: min(86vh, 900px); padding: clamp(28px, 4vw, 52px); }
  .pmodal__title {
    font-family: var(--font); font-weight: 300; letter-spacing: -.02em;
    font-size: clamp(1.7rem, 3.2vw, 2.4rem); line-height: 1.15; color: var(--white); margin-top: 18px;
  }
  .pmodal__body {
    display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem); margin-top: clamp(2rem, 4vw, 3rem);
  }
  .pmodal__text { display: flex; flex-direction: column; gap: 30px; }
  .pmodal__foot { display: flex; flex-wrap: wrap; gap: 16px; margin-top: clamp(2rem, 4vw, 3rem); }
  .pmodal__close {
    position: absolute; top: 18px; right: 18px; z-index: 2;
    width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center;
    border-radius: 999px; cursor: pointer;
    background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.14); color: var(--white);
    transition: background .25s, color .25s;
  }
  .pmodal__close:hover { background: var(--primary); color: #191919; }
  @media (max-width: 860px) { .pmodal__body { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .ptile { transition: none; } }
</style>

<script>
  // ---- Empilement des cartes projet ----
  // Quand la carte suivante recouvre la carte i, celle-ci recule dans la pile :
  // elle rétrécit (origine bas, donc le liseré visible reste en place) et s'assombrit.
  const cards = Array.from(document.querySelectorAll(".dcard"));
  const noMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const stackable = () => window.innerWidth > 900 && !noMotion;

  // Offset de pin : la carte ne se fige qu'une fois lue en entier.
  // Les cartes suivantes se figent 26px plus haut → liseré visible de la pile.
  const BASE = 22, STEP = 26;
  function layout() {
    if (!stackable()) {
      cards.forEach((c) => c.style.removeProperty("--stack-top"));
      return;
    }
    const vh = window.innerHeight;
    cards.forEach((c, i) => {
      const h = c.offsetHeight; // insensible au scale appliqué par paint()
      c.style.setProperty("--stack-top", Math.round(vh - BASE - i * STEP - h) + "px");
    });
  }

  let frame = null;
  function paint() {
    frame = null;
    if (!stackable()) {
      cards.forEach((c) => { c.style.transform = ""; c.style.opacity = ""; });
      return;
    }
    for (let i = 0; i < cards.length - 1; i++) {
      const here = cards[i].getBoundingClientRect();
      const next = cards[i + 1].getBoundingClientRect();
      // 0 = pas encore recouverte, 1 = entièrement recouverte
      const raw = (here.bottom - next.top) / here.height;
      const t = Math.min(1, Math.max(0, raw));
      const e = t * t * (3 - 2 * t); // smoothstep
      cards[i].style.transform = `scale(${(1 - 0.055 * e).toFixed(4)})`;
      cards[i].style.opacity = `${(1 - 0.42 * e).toFixed(3)}`;
    }
  }
  function schedule() { if (!frame) frame = requestAnimationFrame(paint); }

  if (cards.length > 1) {
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", () => { layout(); schedule(); });
    // les hauteurs bougent tant que polices et images ne sont pas chargées
    window.addEventListener("load", () => { layout(); schedule(); });
    if (document.fonts) document.fonts.ready.then(() => { layout(); schedule(); });
    layout();
    schedule();
  }
</script>

<script>
  // --- Filtres : masquent les tuiles hors catégorie ---
  const grid = document.getElementById("plist-grid");
  const empty = document.getElementById("plist-empty");
  const filters = document.querySelectorAll(".pfilter");

  filters.forEach((btn) => {
    btn.addEventListener("click", () => {
      const want = btn.getAttribute("data-filter");
      filters.forEach((b) => {
        const on = b === btn;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-pressed", String(on));
      });
      let shown = 0;
      grid?.querySelectorAll(".ptile").forEach((tile) => {
        const ok = want === "all" || tile.getAttribute("data-category") === want;
        tile.hidden = !ok;
        if (ok) shown++;
      });
      if (empty) empty.hidden = shown > 0;
      layout();
    });
  });

  // --- Quinconce : rééquilibre les tuiles dans la colonne la plus courte ---
  const cols = grid ? Array.from(grid.querySelectorAll(".plist__col")) : [];
  const allTiles = grid ? Array.from(grid.querySelectorAll(".ptile")) : [];
  function layout() {
    if (!grid || !cols.length) return;
    const n = window.innerWidth <= 680 ? 1 : window.innerWidth <= 1024 ? 2 : 3;
    cols.forEach((c, i) => { c.hidden = i >= n; });
    const h = new Array(n).fill(0);
    allTiles.forEach((tile) => {
      if (tile.hidden) return;
      const i = h.indexOf(Math.min(...h));
      cols[i].appendChild(tile);
      h[i] += tile.offsetHeight + 24;
    });
  }
  layout();
  let rz;
  window.addEventListener("resize", () => { clearTimeout(rz); rz = setTimeout(layout, 150); });

  // --- Pop-ups ---
  document.querySelectorAll("[data-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const dlg = document.getElementById(`modal-${btn.getAttribute("data-open")}`);
      if (dlg instanceof HTMLDialogElement) dlg.showModal();
    });
  });

  document.querySelectorAll(".pmodal").forEach((dlg) => {
    if (!(dlg instanceof HTMLDialogElement)) return;
    dlg.querySelector("[data-close]")?.addEventListener("click", () => dlg.close());
    // clic sur le fond (hors de la zone de contenu) = fermeture
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });
  });
</script>
