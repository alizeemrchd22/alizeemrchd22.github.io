---
import "../styles/global.css";
import FloatingNav from "../components/FloatingNav.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { site } from "../data/content";

interface Props {
  title?: string;
  description?: string;
  /** true uniquement sur les pages qui ont un dictionnaire de traduction
   *  branché (voir src/i18n/). Sert au sélecteur de langue à savoir s'il
   *  doit retomber sur l'anglais par défaut sur les pages pas encore traduites. */
  translated?: boolean;
  /** Schéma JSON-LD supplémentaire propre à la page (ex. un projet). */
  structuredData?: Record<string, unknown>;
}
const {
  title = `${site.name} — ${site.role}`,
  description = site.tagline,
  translated = false,
  structuredData,
} = Astro.props;

// URLs absolues : indispensables pour les aperçus de partage et le canonique.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og-image.jpg", Astro.site).href;

// Identité déclarée une seule fois, référencée par les autres schémas via @id.
const personId = new URL("/#person", Astro.site).href;
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": personId,
    name: site.name,
    url: new URL("/", Astro.site).href,
    image: ogImage,
    jobTitle: site.role,
    description: site.tagline,
    email: `mailto:${site.email}`,
    telephone: site.phone,
    address: { "@type": "PostalAddress", addressLocality: "Sydney", addressCountry: "AU" },
    sameAs: site.socials.map((s) => s.href),
    knowsLanguage: ["fr", "en", "es"],
    alumniOf: [
      { "@type": "CollegeOrUniversity", name: "University of Technology Sydney" },
      { "@type": "CollegeOrUniversity", name: "IPAG Business School" },
    ],
    knowsAbout: [
      "Data Science", "Machine Learning", "Python", "SQL",
      "UX/UI Design", "Project Management",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    url: new URL("/", Astro.site).href,
    name: `${site.name} — Portfolio`,
    inLanguage: "en",
    author: { "@id": personId },
  },
  ...(structuredData ? [structuredData] : []),
];
---

<!doctype html>
<html lang="en" data-i18n-ready={translated ? "true" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#191919" />

    <!-- Favicon : icône soleil du site. Le SVG est utilisé par les navigateurs
         modernes, le .ico sert de repli, le PNG pour l'écran d'accueil iOS. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph (LinkedIn, Facebook, WhatsApp, Slack…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.name} — ${site.role}`} />

    <!-- Données structurées (schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Police Kantumruy Pro (identique à la maquette) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@300;400;500;600;700&family=Red+Hat+Display:wght@400;500;700&family=Red+Hat+Mono:wght@400;500&family=JetBrains+Mono:wght@700&family=Manrope:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <script is:inline>
      // Active les animations uniquement si JS tourne (fallback : tout reste visible)
      document.documentElement.classList.add("js");
    </script>
    <a href="#main" class="skip-link">Skip to content</a>
    <FloatingNav />
    <LanguageSwitcher />
    <slot />

    <script>
      // Révélation douce au scroll (respecte prefers-reduced-motion via le CSS)
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
